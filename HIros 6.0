-- Доступность: единый множитель длительности всех анимаций.
-- Library:SetAccessibility({ ReduceMotion = true }) ставит масштаб в 0, поэтому
-- интерфейс не анимируется, но остаётся полностью рабочим. Обёртка сохраняет
-- прежний синтаксис TweenService:Create(...) во всём файле.
local TWEEN_SCALE = 1
local function scaledTweenInfo(info)
    if TWEEN_SCALE == 1 then return info end
    if typeof(info) ~= "TweenInfo" then return info end
    return TweenInfo.new(
        (tonumber(info.Time) or 0) * TWEEN_SCALE,
        info.EasingStyle,
        info.EasingDirection,
        info.RepeatCount,
        info.Reverses,
        info.DelayTime
    )
end
TweenService = setmetatable({}, {
    __index = function(_, key)
        if key == "Create" then
            return function(_, target, info, props)
                return _RealTweenService:Create(target, scaledTweenInfo(info), props)
            end
        end
        return function(_, ...) return _RealTweenService[key](_RealTweenService, ...) end
    end,
})

