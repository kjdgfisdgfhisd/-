function Library:_addSection(tab, config)
    local wrap = Instance.new("Frame")
    wrap.BackgroundTransparency = 1
    wrap.Size = UDim2.new(1, 0, 0, 26)
    wrap.LayoutOrder = config.Order or 0
    wrap.ZIndex = 4
    wrap.Parent = tab.Content

    local dot = Instance.new("Frame")
    dot.AnchorPoint = Vector2.new(0, 0.5)
    dot.Position = UDim2.new(0, 0, 0.5, -2)
    dot.Size = UDim2.new(0, 6, 0, 6)
    dot.BackgroundColor3 = THEMES[currentThemeKey].Accent
    dot.BorderSizePixel = 0
    dot.ZIndex = 4
    dot.Parent = wrap
    createCorner(dot, 999)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 14, 0, 0)
    label.Size = UDim2.new(1, -14, 1, -2)
    label.Font = Enum.Font.GothamBold
    label.Text = upperText(config.Text or "Section")
    label.TextColor3 = SUBTEXT
    label.TextSize = 11
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 4
    label.Parent = wrap

    local line = Instance.new("Frame")
    line.BackgroundColor3 = THEMES[currentThemeKey].Accent
    line.BorderSizePixel = 0
    line.Position = UDim2.new(0, 0, 1, -1)
    line.Size = UDim2.new(1, 0, 0, 1)
    line.ZIndex = 4
    line.Parent = wrap
    local lineGrad = Instance.new("UIGradient")
    lineGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0.3),
        NumberSequenceKeypoint.new(1, 1),
    })
    lineGrad.Parent = line

    self._sections[wrap] = true
    local function updateTheme()
        dot.BackgroundColor3 = THEMES[currentThemeKey].Accent
        line.BackgroundColor3 = THEMES[currentThemeKey].Accent
    end
    table.insert(self.Elements, { Type = "Section", Instance = wrap, UpdateTheme = updateTheme })

    return wrap
end

-- ============================================================
-- KEYBIND (режимы Press / Hold / Toggle и предупреждение о конфликтах)
-- ============================================================
-- local bind = tab:CreateKeybind({
--     Name = "ESP", Flag = "esp_key", Mode = "Toggle", CurrentKeybind = Enum.KeyCode.F,
--     Callback = function(key, mode, state) end,
-- })
-- bind:SetMode("Hold")  bind:CycleMode()  bind:GetState()  bind:GetConflict()
-- Callback(keycode, mode, state): Press/Hold получают state = true на нажатии,
-- Hold — ещё state = false на отпускании, Toggle — переключает состояние.
-- Клавиши разных хоткеев проверяются на совпадение: у конфликтующих биндов
-- жёлтая рамка и подпись «⚠ Имя», а Library:GetKeybindConflicts() даёт полный список.
local KEYBIND_MODES = { "Press", "Hold", "Toggle" }

local function listHas(list, value)
    for _, item in ipairs(list) do
        if item == value then return true end
    end
    return false
end

function Library:_registerKeybind(entry)
    self._keybinds = self._keybinds or {}
    table.insert(self._keybinds, entry)
    self:RefreshKeybindConflicts()
    return entry
end

function Library:GetKeybinds()
    local out = {}
    for i, entry in ipairs(self._keybinds or {}) do
        out[i] = {
            Name = entry.Name,
            Key = entry.GetKey(),
            Mode = entry.GetMode(),
            State = entry.GetState(),
            Conflict = entry.GetConflict(),
            Instance = entry.Instance,
        }
    end
    return out
end

-- Возвращает { [KeyName] = { "Бинд 1", "Бинд 2", ... } } — только реальные конфликты.
function Library:GetKeybindConflicts()
    local grouped = {}
    for _, entry in ipairs(self._keybinds or {}) do
        local key = entry.GetKey()
        local keyName = key and (typeof(key) == "EnumItem" and key.Name or tostring(key)) or ""
        if keyName ~= "" and keyName ~= "None" then
            grouped[keyName] = grouped[keyName] or {}
            table.insert(grouped[keyName], entry.Name or "Keybind")
        end
    end
    local conflicts = {}
    for keyName, names in pairs(grouped) do
        if #names > 1 then conflicts[keyName] = names end
    end
    return conflicts
end

function Library:RefreshKeybindConflicts()
    local conflicts = self:GetKeybindConflicts()
    for _, entry in ipairs(self._keybinds or {}) do
        local key = entry.GetKey()
        local keyName = key and (typeof(key) == "EnumItem" and key.Name or tostring(key)) or ""
        local names = conflicts[keyName]
        if names then
            local copy = {}
            for i, name in ipairs(names) do
                if name ~= entry.Name then copy[#copy + 1] = name end
            end
            entry.SetConflict(copy)
        else
            entry.SetConflict(nil)
        end
    end
    return conflicts
end

function Library:_addKeybind(tab, config)
    local self = self
    local flag = config.Flag

    local function decodeKey(v)
        if typeof(v) == "EnumItem" then return v end
        if type(v) == "string" and v ~= "" and v ~= "null" then
            local ok, kc = pcall(function() return Enum.KeyCode[v] end)
            if ok and kc then return kc end
        end
        return nil
    end

    local function normalizeMode(value)
        if type(value) ~= "string" then return nil end
        for _, known in ipairs(KEYBIND_MODES) do
            if lowerText(known) == lowerText(value) then return known end
        end
        return nil
    end

    local modeList = {}
    for _, candidate in ipairs(type(config.Modes) == "table" and config.Modes or KEYBIND_MODES) do
        local known = normalizeMode(candidate)
        if known and not listHas(modeList, known) then modeList[#modeList + 1] = known end
    end
    if #modeList == 0 then modeList = { "Press" } end

    local current
    if flag and self.Flags[flag] ~= nil then current = decodeKey(self.Flags[flag]) end
    if not current then current = config.CurrentKeybind or Enum.KeyCode.RightShift end

    local mode = normalizeMode(config.Mode) or normalizeMode(flag and self.Flags[flag .. "_mode"])
    if not mode or not listHas(modeList, mode) then mode = modeList[1] end

    local listening = false
    local state = false
    local conflictNames = nil
    local listenConn

    local row = makeRowBase(tab.Content, config.Order, 40)
    row.Text = "   " .. (config.Name or "Keybind")
    addHover(row, self)

    local conflictLabel = Instance.new("TextLabel")
    conflictLabel.Name = "KeybindConflict"
    conflictLabel.BackgroundTransparency = 1
    conflictLabel.Position = UDim2.new(1, -216, 0.5, -9)
    conflictLabel.Size = UDim2.new(0, 64, 0, 18)
    conflictLabel.Font = Enum.Font.GothamMedium
    conflictLabel.Text = ""
    conflictLabel.TextColor3 = Color3.fromRGB(255, 180, 60)
    conflictLabel.TextSize = 10
    conflictLabel.TextXAlignment = Enum.TextXAlignment.Right
    conflictLabel.TextTruncate = Enum.TextTruncate.AtEnd
    conflictLabel.ZIndex = 5
    conflictLabel.Parent = row

    local modeBadge = Instance.new("TextButton")
    modeBadge.Name = "KeybindMode"
    modeBadge.Size = UDim2.new(0, 52, 0, 24)
    modeBadge.Position = UDim2.new(1, -148, 0.5, -12)
    modeBadge.BackgroundColor3 = BG_HOVER
    modeBadge.AutoButtonColor = false
    modeBadge.Font = Enum.Font.GothamBold
    modeBadge.Text = mode
    modeBadge.TextColor3 = SUBTEXT
    modeBadge.TextSize = 10
    modeBadge.ZIndex = 5
    modeBadge.Parent = row
    createCorner(modeBadge, 8)

    local keyBadge = Instance.new("TextButton")
    keyBadge.Name = "KeybindKey"
    keyBadge.Size = UDim2.new(0, 84, 0, 26)
    keyBadge.Position = UDim2.new(1, -92, 0.5, -13)
    keyBadge.BackgroundColor3 = BG_HOVER
    keyBadge.AutoButtonColor = false
    keyBadge.Font = Enum.Font.GothamBold
    keyBadge.Text = current and current.Name or "None"
    keyBadge.TextColor3 = TEXT_COLOR
    keyBadge.TextSize = 12
    keyBadge.ZIndex = 5
    keyBadge.Parent = row
    createCorner(keyBadge, 8)

    local badgeStroke = Instance.new("UIStroke")
    badgeStroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    badgeStroke.Color = THEMES[currentThemeKey].Accent
    badgeStroke.Transparency = 1
    badgeStroke.Thickness = 1.5
    badgeStroke.Parent = keyBadge

    local CONFLICT_COLOR = Color3.fromRGB(255, 180, 60)

    local function refresh()
        local hasConflict = conflictNames ~= nil and #conflictNames > 0
        keyBadge.Text = listening and "..." or (current and current.Name or "None")
        modeBadge.Text = mode
        modeBadge.TextColor3 = (state and mode ~= "Press") and Color3.fromRGB(255, 255, 255) or SUBTEXT
        modeBadge.BackgroundColor3 = (state and mode ~= "Press") and THEMES[currentThemeKey].Accent or BG_HOVER
        if hasConflict then
            badgeStroke.Color = CONFLICT_COLOR
            badgeStroke.Transparency = 0.1
            local suffix = #conflictNames > 1 and (" +" .. (#conflictNames - 1)) or ""
            conflictLabel.Text = "⚠ " .. tostring(conflictNames[1]) .. suffix
        else
            badgeStroke.Color = THEMES[currentThemeKey].Accent
            badgeStroke.Transparency = listening and 0.2 or 1
            conflictLabel.Text = ""
        end
    end

    local function setMode(value)
        local known = normalizeMode(value)
        if not known or not listHas(modeList, known) then return false end
        mode = known
        state = false
        if flag then self:SetFlag(flag .. "_mode", mode) end
        refresh()
        return true
    end

    local function cycleMode()
        local index = 1
        for i, known in ipairs(modeList) do
            if known == mode then index = i end
        end
        return setMode(modeList[index % #modeList + 1])
    end

    local function stopListen()
        listening = false
        if listenConn then listenConn:Disconnect() listenConn = nil end
        refresh()
    end

    local function startListen()
        if listening then stopListen() return end
        listening = true
        refresh()
        listenConn = UserInputService.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if input.KeyCode == Enum.KeyCode.Escape then stopListen() return end
            current = input.KeyCode
            stopListen()
            self:SetFlag(flag, current.Name)
            self:RefreshKeybindConflicts()
            if config.Callback then config.Callback(current, mode, state) end
        end)
    end

    keyBadge.MouseButton1Click:Connect(startListen)
    modeBadge.MouseButton1Click:Connect(function()
        if config.ModeCycling == false then return end
        cycleMode()
    end)

    -- Боевые нажатия: работают всегда, кроме момента переназначения клавиши.
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if listening or not current then return end
        if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
        if input.KeyCode ~= current then return end
        if gameProcessed and config.IgnoreGameProcessed ~= false then return end
        if mode == "Toggle" then
            state = not state
        else
            state = true
        end
        refresh()
        if type(config.Callback) == "function" then config.Callback(current, mode, state) end
        if type(config.OnDown) == "function" then config.OnDown(current, state) end
    end)

    if listHas(modeList, "Hold") then
        UserInputService.InputEnded:Connect(function(input)
            if listening or not current then return end
            if input.UserInputType ~= Enum.UserInputType.Keyboard then return end
            if input.KeyCode ~= current then return end
            if mode ~= "Hold" or not state then return end
            state = false
            refresh()
            if type(config.Callback) == "function" then config.Callback(current, mode, false) end
            if type(config.OnUp) == "function" then config.OnUp(current, false) end
        end)
    end

    refresh()

    local obj
    obj = {
        Instance = row,
        Get = function() return current end,
        Set = function(first, second)
            local kc
            if first == obj then kc = second else kc = first end
            current = decodeKey(kc) or kc
            refresh()
            self:SetFlag(flag, current and current.Name or nil)
            self:RefreshKeybindConflicts()
            if config.Callback then config.Callback(current, mode, state) end
            return obj
        end,
        GetMode = function() return mode end,
        SetMode = function(first, second)
            local value
            if first == obj then value = second else value = first end
            return setMode(value)
        end,
        CycleMode = function() return cycleMode() end,
        GetState = function() return state and true or false end,
        IsActive = function() return state and true or false end,
        SetState = function(first, second)
            -- вызов и точкой, и двоеточием; возвращаем true (успех), а состояние читай GetState()
            local value
            if first == obj then value = second else value = first end
            state = value and true or false
            refresh()
            return true
        end,
        GetConflict = function()
            local out = {}
            for i, name in ipairs(conflictNames or {}) do out[i] = name end
            return out
        end,
        UpdateTheme = refresh,
    }
    table.insert(self.Elements, { Type = "Keybind", Instance = row, UpdateTheme = refresh })
    if flag then table.insert(self._flagElements, { flag = flag, obj = obj }) end

    self:_registerKeybind({
        Name = config.Name or "Keybind",
        Instance = row,
        GetKey = function() return current end,
        GetMode = function() return mode end,
        GetState = function() return state and true or false end,
        GetConflict = function() return obj.GetConflict() end,
        SetConflict = function(names)
            conflictNames = names
            refresh()
        end,
    })
    return obj
end


function Library:_addParagraph(tab, config)
    local card = Instance.new("Frame")
    card.BackgroundColor3 = BG_ITEM
    card.BorderSizePixel = 0
    card.AutomaticSize = Enum.AutomaticSize.Y
    card.Size = UDim2.new(1, 0, 0, 0)
    card.LayoutOrder = config.Order or 0
    card.ZIndex = 4
    card.Parent = tab.Content
    createCorner(card, 10)

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 10)
    pad.PaddingBottom = UDim.new(0, 10)
    pad.PaddingLeft = UDim.new(0, 12)
    pad.PaddingRight = UDim.new(0, 12)
    pad.Parent = card

    local innerLayout = Instance.new("UIListLayout")
    innerLayout.Padding = UDim.new(0, 4)
    innerLayout.Parent = card

    if config.Title then
        local title = Instance.new("TextLabel")
        title.BackgroundTransparency = 1
        title.AutomaticSize = Enum.AutomaticSize.Y
        title.Size = UDim2.new(1, 0, 0, 0)
        title.Font = Enum.Font.GothamBold
        title.Text = config.Title
        title.TextColor3 = TEXT_COLOR
        title.TextSize = 13
        title.TextWrapped = true
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.LayoutOrder = 1
        title.ZIndex = 5
        title.Parent = card
    end

    local body = Instance.new("TextLabel")
    body.BackgroundTransparency = 1
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.Size = UDim2.new(1, 0, 0, 0)
    body.Font = Enum.Font.Gotham
    body.Text = config.Content or config.Text or ""
    body.TextColor3 = SUBTEXT
    body.TextSize = 12
    body.TextWrapped = true
    body.TextXAlignment = Enum.TextXAlignment.Left
    body.LayoutOrder = 2
    body.ZIndex = 5
    body.Parent = card

    return card
end

function Library:_addProgressBar(tab, config)
    local self = self
    local min = config.Min or 0
    local max = config.Max or 100
    local value = config.CurrentValue or min

    local row = Instance.new("Frame")
    row.BackgroundColor3 = BG_ITEM
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, 0, 0, 44)
    row.LayoutOrder = config.Order or 0
    row.ZIndex = 4
    row.Parent = tab.Content
    createCorner(row, 10)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Size = UDim2.new(1, -90, 0, 22)
    label.Font = Enum.Font.GothamMedium
    label.Text = config.Name or "Progress"
    label.TextColor3 = TEXT_COLOR
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 5
    label.Parent = row

    local valueLabel = Instance.new("TextLabel")
    valueLabel.BackgroundTransparency = 1
    valueLabel.Position = UDim2.new(1, -80, 0, 0)
    valueLabel.Size = UDim2.new(0, 68, 0, 22)
    valueLabel.Font = Enum.Font.GothamBold
    valueLabel.Text = string.format("%d%%", math.floor((value - min) / (max - min) * 100))
    valueLabel.TextColor3 = THEMES[currentThemeKey].Accent
    valueLabel.TextSize = 13
    valueLabel.TextXAlignment = Enum.TextXAlignment.Right
    valueLabel.ZIndex = 5
    valueLabel.Parent = row

    local track = Instance.new("Frame")
    track.Size = UDim2.new(1, -24, 0, 8)
    track.Position = UDim2.new(0, 12, 0, 28)
    track.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
    track.BorderSizePixel = 0
    track.ZIndex = 5
    track.Parent = row
    createCorner(track, 999)

    local fill = Instance.new("Frame")
    fill.Size = UDim2.new(0, 0, 1, 0)
    fill.BackgroundColor3 = THEMES[currentThemeKey].Accent
    fill.BorderSizePixel = 0
    fill.ZIndex = 6
    fill.Parent = track
    createCorner(fill, 999)

    local function update()
        local alpha = (max - min > 0) and math.clamp((value - min) / (max - min), 0, 1) or 0
        TweenService:Create(fill, TweenInfo.new(0.25), { Size = UDim2.new(alpha, 0, 1, 0) }):Play()
        fill.BackgroundColor3 = THEMES[currentThemeKey].Accent
        valueLabel.Text = string.format("%d%%", math.floor(alpha * 100))
        valueLabel.TextColor3 = THEMES[currentThemeKey].Accent
    end
    update()

    local animToken = 0
    local obj = {
        Instance = row,
        Get = function() return value end,
        Set = function(v)
            local target = math.clamp(v, min, max)
            animToken = animToken + 1
            local myToken = animToken
            local proxy = Instance.new("NumberValue")
            proxy.Value = value
            local conn
            conn = proxy:GetPropertyChangedSignal("Value"):Connect(function()
                if myToken ~= animToken then return end
                value = proxy.Value
                update()
            end)
            local tw = TweenService:Create(proxy, TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), { Value = target })
            tw:Play()
            tw.Completed:Connect(function()
                conn:Disconnect()
                proxy:Destroy()
                if myToken ~= animToken then return end
                value = target
                update()
            end)
        end,
        UpdateTheme = update,
    }
    table.insert(self.Elements, { Type = "ProgressBar", Instance = row, UpdateTheme = update })
    return obj
end

function Library:_addStepper(tab, config)
    local self = self
    local min = config.Min or 0
    local max = config.Max or 10
    local step = config.Increment or 1
    local flag = config.Flag
    local value
    if flag and type(self.Flags[flag]) == "number" then value = self.Flags[flag]
    else value = config.CurrentValue or min end

    local row = makeRowBase(tab.Content, config.Order, 40)
    addHover(row, self)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Size = UDim2.new(1, -170, 1, 0)
    label.Font = Enum.Font.GothamMedium
    label.Text = config.Name or "Stepper"
    label.TextColor3 = TEXT_COLOR
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 5
    label.Parent = row

    local minus = Instance.new("TextButton")
    minus.Size = UDim2.new(0, 28, 0, 26)
    minus.Position = UDim2.new(1, -120, 0.5, -13)
    minus.BackgroundColor3 = BG_HOVER
    minus.BorderSizePixel = 0
    minus.Font = Enum.Font.GothamBold
    minus.Text = "➖"
    minus.TextColor3 = TEXT_COLOR
    minus.TextSize = 12
    minus.ZIndex = 5
    minus.Parent = row
    createCorner(minus, 6)

    local valLbl = Instance.new("TextLabel")
    valLbl.BackgroundTransparency = 1
    valLbl.Position = UDim2.new(1, -90, 0, 0)
    valLbl.Size = UDim2.new(0, 40, 1, 0)
    valLbl.Font = Enum.Font.GothamBold
    valLbl.Text = tostring(value)
    valLbl.TextColor3 = THEMES[currentThemeKey].Accent
    valLbl.TextSize = 13
    valLbl.ZIndex = 5
    valLbl.Parent = row

    local plus = Instance.new("TextButton")
    plus.Size = UDim2.new(0, 28, 0, 26)
    plus.Position = UDim2.new(1, -46, 0.5, -13)
    plus.BackgroundColor3 = BG_HOVER
    plus.BorderSizePixel = 0
    plus.Font = Enum.Font.GothamBold
    plus.Text = "➕"
    plus.TextColor3 = TEXT_COLOR
    plus.TextSize = 12
    plus.ZIndex = 5
    plus.Parent = row
    createCorner(plus, 6)

    local function update()
        valLbl.Text = tostring(value)
        valLbl.TextColor3 = THEMES[currentThemeKey].Accent
    end

    minus.MouseButton1Click:Connect(function()
        self:_play("Click")
        value = math.max(min, value - step)
        update()
        self:SetFlag(flag, value)
        if config.Callback then config.Callback(value) end
    end)
    plus.MouseButton1Click:Connect(function()
        self:_play("Click")
        value = math.min(max, value + step)
        update()
        self:SetFlag(flag, value)
        if config.Callback then config.Callback(value) end
    end)

    if flag and self.Flags[flag] ~= nil and config.Callback then
        task.defer(function() config.Callback(value) end)
    end

    local obj = {
        Instance = row,
        Get = function() return value end,
        Set = function(v)
            value = math.clamp(v, min, max)
            update()
            self:SetFlag(flag, value)
            if config.Callback then config.Callback(value) end
        end,
    }
    table.insert(self.Elements, { Type = "Stepper", Instance = row, UpdateTheme = update })
    if flag then table.insert(self._flagElements, { flag = flag, obj = obj }) end
    return obj
end

function Library:_addRadioGroup(tab, config)
    local self = self
    local flag = config.Flag
    local options = config.Options or {}
    local current
    if flag and self.Flags[flag] ~= nil then current = self.Flags[flag]
    else current = config.CurrentOption or options[1] end

    local wrap = Instance.new("Frame")
    wrap.BackgroundTransparency = 1
    wrap.Size = UDim2.new(1, 0, 0, 60)
    wrap.LayoutOrder = config.Order or 0
    wrap.ZIndex = 4
    wrap.Parent = tab.Content

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 12, 0, 0)
    label.Size = UDim2.new(1, -24, 0, 20)
    label.Font = Enum.Font.GothamMedium
    label.Text = config.Name or "RadioGroup"
    label.TextColor3 = TEXT_COLOR
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 5
    label.Parent = wrap

    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Position = UDim2.new(0, 0, 0, 24)
    row.Size = UDim2.new(1, 0, 0, 32)
    row.ZIndex = 5
    row.Parent = wrap

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 6)
    layout.Parent = row

    local buttons = {}

    local function update()
        for _, data in ipairs(buttons) do
            local on = (data.Name == current)
            TweenService:Create(data.Btn, TweenInfo.new(0.15), {
                BackgroundColor3 = on and THEMES[currentThemeKey].Accent or BG_ITEM,
                TextColor3 = on and Color3.fromRGB(255,255,255) or TEXT_COLOR,
            }):Play()
        end
    end

    for _, opt in ipairs(options) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0, 80, 1, 0)
        btn.BackgroundColor3 = BG_ITEM
        btn.AutoButtonColor = false
        btn.BorderSizePixel = 0
        btn.Font = Enum.Font.GothamMedium
        btn.Text = tostring(opt)
        btn.TextColor3 = TEXT_COLOR
        btn.TextSize = 12
        btn.ZIndex = 5
        btn.Parent = row
        createCorner(btn, 8)

        btn.MouseButton1Click:Connect(function()
            self:_play("Click")
            current = opt
            update()
            self:SetFlag(flag, current)
            if config.Callback then config.Callback(current) end
        end)
        table.insert(buttons, { Name = opt, Btn = btn })
    end
    update()

    if flag and self.Flags[flag] ~= nil and config.Callback then
        task.defer(function() config.Callback(current) end)
    end

    local obj = {
        Instance = wrap,
        Get = function() return current end,
        Set = function(v)
            current = v
            update()
            self:SetFlag(flag, current)
            if config.Callback then config.Callback(current) end
        end,
        UpdateTheme = update,
    }
    table.insert(self.Elements, { Type = "RadioGroup", Instance = wrap, UpdateTheme = update })
    if flag then table.insert(self._flagElements, { flag = flag, obj = obj }) end
    return obj
end

function Library:_addRow(tab, config)
    local row = Instance.new("Frame")
    row.BackgroundTransparency = 1
    row.Size = UDim2.new(1, 0, 0, 40)
    row.LayoutOrder = config.Order or 0
    row.ZIndex = 4
    row.Parent = tab.Content

    local layout = Instance.new("UIListLayout")
    layout.FillDirection = Enum.FillDirection.Horizontal
    layout.Padding = UDim.new(0, 6)
    layout.Parent = row

    return row
end

----------------------------------------------------------------
-- LOADER (крутящийся спиннер-кольцо, без внешних картинок)
----------------------------------------------------------------
function Library:_addLoader(tab, config)
    local row = Instance.new("Frame")
    row.BackgroundColor3 = BG_ITEM
    row.BorderSizePixel = 0
    row.Size = UDim2.new(1, 0, 0, 44)
    row.LayoutOrder = config.Order or 0
    row.ZIndex = 4
    row.Parent = tab.Content
    createCorner(row, 10)

    local label = Instance.new("TextLabel")
    label.BackgroundTransparency = 1
    label.Position = UDim2.new(0, 50, 0, 0)
    label.Size = UDim2.new(1, -62, 1, 0)
    label.Font = Enum.Font.GothamMedium
    label.Text = config.Name or "Загрузка..."
    label.TextColor3 = TEXT_COLOR
    label.TextSize = 13
    label.TextXAlignment = Enum.TextXAlignment.Left
    label.ZIndex = 5
    label.Parent = row

    -- Кольцо: круг + радиальный градиент прозрачности + вырезанная
    -- внутренняя часть = получается дуга, которую мы просто вращаем
    local ring = Instance.new("Frame")
    ring.Size = UDim2.new(0, 22, 0, 22)
    ring.Position = UDim2.new(0, 14, 0.5, -11)
    ring.BackgroundTransparency = 1
    ring.ZIndex = 5
    ring.Parent = row

    local ringVisual = Instance.new("Frame")
    ringVisual.Size = UDim2.new(1, 0, 1, 0)
    ringVisual.BackgroundColor3 = THEMES[currentThemeKey].Accent
    ringVisual.BorderSizePixel = 0
    ringVisual.ZIndex = 5
    ringVisual.Parent = ring
    createCorner(ringVisual, 999)

    local ringGrad = Instance.new("UIGradient")
    ringGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 0),
        NumberSequenceKeypoint.new(0.5, 0.85),
        NumberSequenceKeypoint.new(1, 1),
    })
    ringGrad.Parent = ringVisual

    local ringHole = Instance.new("Frame")
    ringHole.AnchorPoint = Vector2.new(0.5, 0.5)
    ringHole.Position = UDim2.new(0.5, 0, 0.5, 0)
    ringHole.Size = UDim2.new(1, -8, 1, -8)
    ringHole.BackgroundColor3 = BG_ITEM
    ringHole.BorderSizePixel = 0
    ringHole.ZIndex = 6
    ringHole.Parent = ring
    createCorner(ringHole, 999)

    local spinning = (config.Active ~= false)
    task.spawn(function()
        while ring.Parent do
            if spinning then
                ring.Rotation = (ring.Rotation + 6) % 360
            end
            RunService.Heartbeat:Wait()
        end
    end)

    local function updateTheme()
        ringVisual.BackgroundColor3 = THEMES[currentThemeKey].Accent
        ringHole.BackgroundColor3 = BG_ITEM
    end

    local obj = {
        Instance = row,
        SetActive = function(active) spinning = active end,
        SetName = function(text) label.Text = text end,
        UpdateTheme = updateTheme,
    }
    table.insert(self.Elements, { Type = "Loader", Instance = row, UpdateTheme = updateTheme })
    return obj
end

function Library:_addColorPicker(tab, config)
    local self = self
    local flag = config.Flag
    local current
    if flag and typeof(self.Flags[flag]) == "Color3" then current = self.Flags[flag]
    else current = config.CurrentValue or THEMES[currentThemeKey].Accent end
    local open = false
    local h, s, v = Color3.toHSV(current)

    local row = makeRowBase(tab.Content, config.Order, 40)
    row.Text = "   " .. (config.Name or "Color")
    addHover(row, self)

    local preview = Instance.new("Frame")
    preview.Size = UDim2.new(0, 22, 0, 22)
    preview.Position = UDim2.new(1, -32, 0.5, -11)
    preview.BackgroundColor3 = current
    preview.BorderSizePixel = 0
    preview.ZIndex = 5
    preview.Parent = row
    createCorner(preview, 8)

    local holder = Instance.new("Frame")
    holder.BackgroundColor3 = BG_PANEL
    holder.BorderSizePixel = 0
    holder.Size = UDim2.new(1, 0, 0, 0)
    holder.ClipsDescendants = true
    holder.Visible = false
    holder.LayoutOrder = (config.Order or 0) + 0.5
    holder.ZIndex = 4
    holder.Parent = tab.Content
    createCorner(holder, 10)

    local holderPad = Instance.new("UIPadding")
    holderPad.PaddingTop = UDim.new(0, 10)
    holderPad.PaddingBottom = UDim.new(0, 10)
    holderPad.PaddingLeft = UDim.new(0, 10)
    holderPad.PaddingRight = UDim.new(0, 10)
    holderPad.Parent = holder

    local svField = Instance.new("ImageLabel")
    svField.Size = UDim2.new(1, 0, 0, 100)
    svField.BackgroundColor3 = Color3.fromRGB(255,255,255)
    svField.BorderSizePixel = 0
    svField.ZIndex = 5
    svField.Parent = holder
    createCorner(svField, 8)

    local svGrad = Instance.new("UIGradient")
    svGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
        ColorSequenceKeypoint.new(1, Color3.fromHSV(h, 1, 1)),
    })
    svGrad.Parent = svField

    local svDark = Instance.new("Frame")
    svDark.Size = UDim2.new(1, 0, 1, 0)
    svDark.BackgroundColor3 = Color3.fromRGB(0,0,0)
    svDark.BorderSizePixel = 0
    svDark.ZIndex = 6
    svDark.Parent = svField
    createCorner(svDark, 8)

    local svDarkGrad = Instance.new("UIGradient")
    svDarkGrad.Rotation = 90
    svDarkGrad.Transparency = NumberSequence.new({
        NumberSequenceKeypoint.new(0, 1),
        NumberSequenceKeypoint.new(1, 0),
    })
    svDarkGrad.Parent = svDark

    local svMarker = Instance.new("Frame")
    svMarker.Size = UDim2.new(0, 10, 0, 10)
    svMarker.AnchorPoint = Vector2.new(0.5, 0.5)
    svMarker.BackgroundTransparency = 1
    svMarker.ZIndex = 8
    svMarker.Parent = svField

    local svMarkerStroke = Instance.new("UIStroke")
    svMarkerStroke.Thickness = 2
    svMarkerStroke.Color = Color3.fromRGB(255,255,255)
    svMarkerStroke.Parent = svMarker
    createCorner(svMarker, 999)

    local hueBar = Instance.new("ImageLabel")
    hueBar.Size = UDim2.new(1, 0, 0, 12)
    hueBar.Position = UDim2.new(0, 0, 0, 110)
    hueBar.BackgroundColor3 = Color3.fromRGB(255,255,255)
    hueBar.BorderSizePixel = 0
    hueBar.ZIndex = 5
    hueBar.Parent = holder
    createCorner(hueBar, 999)

    local hueGrad = Instance.new("UIGradient")
    hueGrad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0.00, Color3.fromRGB(255,0,0)),
        ColorSequenceKeypoint.new(0.17, Color3.fromRGB(255,255,0)),
        ColorSequenceKeypoint.new(0.33, Color3.fromRGB(0,255,0)),
        ColorSequenceKeypoint.new(0.50, Color3.fromRGB(0,255,255)),
        ColorSequenceKeypoint.new(0.67, Color3.fromRGB(0,0,255)),
        ColorSequenceKeypoint.new(0.83, Color3.fromRGB(255,0,255)),
        ColorSequenceKeypoint.new(1.00, Color3.fromRGB(255,0,0)),
    })
    hueGrad.Parent = hueBar

    local hueMarker = Instance.new("Frame")
    hueMarker.Size = UDim2.new(0, 12, 0, 12)
    hueMarker.AnchorPoint = Vector2.new(0.5, 0.5)
    hueMarker.BackgroundColor3 = Color3.fromRGB(255,255,255)
    hueMarker.ZIndex = 8
    hueMarker.Parent = hueBar
    createCorner(hueMarker, 999)

    local hueMarkerStroke = Instance.new("UIStroke")
    hueMarkerStroke.Thickness = 2
    hueMarkerStroke.Color = Color3.fromRGB(0,0,0)
    hueMarkerStroke.Transparency = 0.6
    hueMarkerStroke.Parent = hueMarker

    -- alpha slider (опционально)
    local alphaValue = 1
    local alphaBar, alphaFill
    if config.WithAlpha then
        local alphaLabel = Instance.new("TextLabel")
        alphaLabel.BackgroundTransparency = 1
        alphaLabel.Position = UDim2.new(0, 0, 0, 128)
        alphaLabel.Size = UDim2.new(0, 40, 0, 12)
        alphaLabel.Font = Enum.Font.Gotham
        alphaLabel.Text = "Alpha"
        alphaLabel.TextColor3 = SUBTEXT
        alphaLabel.TextSize = 10
        alphaLabel.ZIndex = 5
        alphaLabel.Parent = holder

        alphaBar = Instance.new("Frame")
        alphaBar.Size = UDim2.new(1, -50, 0, 10)
        alphaBar.Position = UDim2.new(0, 50, 0, 128)
        alphaBar.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
        alphaBar.BorderSizePixel = 0
        alphaBar.ZIndex = 5
        alphaBar.Parent = holder
        createCorner(alphaBar, 999)

        alphaFill = Instance.new("Frame")
        alphaFill.Size = UDim2.new(1, 0, 1, 0)
        alphaFill.BackgroundColor3 = current
        alphaFill.BorderSizePixel = 0
        alphaFill.ZIndex = 6
        alphaFill.Parent = alphaBar
        createCorner(alphaFill, 999)
    end

    local hexBox = Instance.new("TextBox")
    hexBox.Size = UDim2.new(1, 0, 0, 24)
    hexBox.Position = UDim2.new(0, 0, 0, config.WithAlpha and 148 or 130)
    hexBox.BackgroundColor3 = BG_ITEM
    hexBox.BorderSizePixel = 0
    hexBox.Font = Enum.Font.GothamMedium
    hexBox.Text = "#000000"
    hexBox.TextColor3 = TEXT_COLOR
    hexBox.TextSize = 12
    hexBox.ClearTextOnFocus = false
    hexBox.ZIndex = 5
    hexBox.Parent = holder
    createCorner(hexBox, 8)

    local hexPad = Instance.new("UIPadding")
    hexPad.PaddingLeft = UDim.new(0, 8)
    hexPad.Parent = hexBox

    local function toHex(c)
        return string.format("#%02X%02X%02X",
            math.floor(c.R*255+0.5), math.floor(c.G*255+0.5), math.floor(c.B*255+0.5))
    end
    local function fromHex(str)
        str = str:gsub("#","")
        if #str ~= 6 then return nil end
        local r = tonumber(str:sub(1,2), 16)
        local g = tonumber(str:sub(3,4), 16)
        local b = tonumber(str:sub(5,6), 16)
        if not (r and g and b) then return nil end
        return Color3.fromRGB(r, g, b)
    end

    local updating = false
    local function refresh()
        updating = true
        svGrad.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255,255,255)),
            ColorSequenceKeypoint.new(1, Color3.fromHSV(h, 1, 1)),
        })
        svMarker.Position = UDim2.new(s, 0, 1 - v, 0)
        hueMarker.Position = UDim2.new(h, 0, 0.5, 0)
        preview.BackgroundColor3 = current
        preview.BackgroundTransparency = config.WithAlpha and (1 - alphaValue) or 0
        hexBox.Text = toHex(current)
        if alphaFill then alphaFill.BackgroundColor3 = current end
        updating = false
    end
    local function apply()
        current = Color3.fromHSV(h, s, v)
        refresh()
        self:SetFlag(flag, current)
        if config.Callback then config.Callback(current, config.WithAlpha and alphaValue or 1) end
    end

    local dsv = false
    local function handleSV(input)
        local pp = pointerPos(input)
        s = math.clamp((pp.X - svField.AbsolutePosition.X) / svField.AbsoluteSize.X, 0, 1)
        v = 1 - math.clamp((pp.Y - svField.AbsolutePosition.Y) / svField.AbsoluteSize.Y, 0, 1)
        apply()
    end
    svField.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dsv = true; handleSV(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dsv and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            handleSV(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dsv = false end
    end)

    local dh = false
    local function handleHue(input)
        h = math.clamp((input.Position.X - hueBar.AbsolutePosition.X) / hueBar.AbsoluteSize.X, 0, 1)
        apply()
    end
    hueBar.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dh = true; handleHue(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dh and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            handleHue(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then dh = false end
    end)

    if alphaBar then
        local da = false
        local function handleAlpha(input)
            alphaValue = math.clamp((input.Position.X - alphaBar.AbsolutePosition.X) / alphaBar.AbsoluteSize.X, 0, 1)
            refresh()
            if config.Callback then config.Callback(current, alphaValue) end
        end
        alphaBar.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                da = true; handleAlpha(input)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if da and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                handleAlpha(input)
            end
        end)
        UserInputService.InputEnded:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then da = false end
        end)
    end

    hexBox.FocusLost:Connect(function()
        if updating then return end
        local col = fromHex(hexBox.Text)
        if col then h, s, v = Color3.toHSV(col) apply()
        else hexBox.Text = toHex(current) end
    end)

    row.MouseButton1Click:Connect(function()
        open = not open
        if open then
            holder.Visible = true
            local hh = config.WithAlpha and 184 or 174
            TweenService:Create(holder, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Size = UDim2.new(1, 0, 0, hh),
            }):Play()
            refresh()
        else
            local t = TweenService:Create(holder, TweenInfo.new(0.18, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
                Size = UDim2.new(1, 0, 0, 0),
            })
            t:Play()
            t.Completed:Connect(function() if not open then holder.Visible = false end end)
        end
    end)

    refresh()

    local obj = {
        Instance = row,
        Get = function() return current end,
        Set = function(col)
            h, s, v = Color3.toHSV(col)
            apply()
        end,
        GetAlpha = function() return alphaValue end,
        SetAlpha = function(a)
            alphaValue = math.clamp(a, 0, 1)
            refresh()
        end,
    }
    table.insert(self.Elements, { Type = "ColorPicker", Instance = row })
    if flag then table.insert(self._flagElements, { flag = flag, obj = obj }) end
    return obj
end

-- ============================================================
-- PLAYER LIST
-- ============================================================
function Library:AddPlayerList(tab, config)
    local self = self
    config = config or {}
    tab:CreateSection({ Text = config.Title or "Игроки" })

    local holder = Instance.new("Frame")
    holder.BackgroundColor3 = BG_ITEM
    holder.BorderSizePixel = 0
    holder.Size = UDim2.new(1, 0, 0, 0)
    holder.AutomaticSize = Enum.AutomaticSize.Y
    holder.ZIndex = 4
    holder.Parent = tab.Content
    createCorner(holder, 10)

    local pad = Instance.new("UIPadding")
    pad.PaddingTop = UDim.new(0, 8)
    pad.PaddingBottom = UDim.new(0, 8)
    pad.PaddingLeft = UDim.new(0, 8)
    pad.PaddingRight = UDim.new(0, 8)
    pad.Parent = holder

    local layout = Instance.new("UIListLayout")
    layout.Padding = UDim.new(0, 4)
    layout.Parent = holder

    local function refresh()
        for _, c in ipairs(holder:GetChildren()) do
            if c:IsA("TextButton") then c:Destroy() end
        end
        for _, plr in ipairs(Players:GetPlayers()) do
            if plr ~= LocalPlayer then
                local r = Instance.new("TextButton")
                r.BackgroundColor3 = BG_ITEM
                r.AutoButtonColor = false
                r.BorderSizePixel = 0
                r.Size = UDim2.new(1, 0, 0, 32)
                r.Font = Enum.Font.GothamMedium
                r.Text = "   " .. plr.Name
                r.TextColor3 = TEXT_COLOR
                r.TextSize = 12
                r.TextXAlignment = Enum.TextXAlignment.Left
                r.ZIndex = 5
                r.Parent = holder
                createCorner(r, 8)

                if config.OnPlayer then
                    r.MouseButton1Click:Connect(function() config.OnPlayer(plr) end)
                end
            end
        end
    end
    refresh()

    local refreshBtn = Instance.new("TextButton")
    refreshBtn.BackgroundColor3 = THEMES[currentThemeKey].Accent
    refreshBtn.BorderSizePixel = 0
    refreshBtn.Size = UDim2.new(1, 0, 0, 32)
    refreshBtn.Font = Enum.Font.GothamBold
    refreshBtn.Text = "🔄 Обновить"
    refreshBtn.TextColor3 = Color3.fromRGB(255,255,255)
    refreshBtn.TextSize = 12
    refreshBtn.ZIndex = 5
    refreshBtn.Parent = holder
    createCorner(refreshBtn, 8)
    refreshBtn.MouseButton1Click:Connect(refresh)

    Players.PlayerAdded:Connect(refresh)
    Players.PlayerRemoving:Connect(function() task.wait(0.1) refresh() end)

    return { Refresh = refresh }
end

-- ============================================================
-- THEME
-- ============================================================
-- Перекрашивает все декоративные элементы v6 под текущую тему
function Library:_applyThemeVisuals()
    local theme = THEMES[currentThemeKey]
    local dark = BG_DARK
    if self.BgGradient then
        self.BgGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, dark:Lerp(theme.Accent, 0.16)),
            ColorSequenceKeypoint.new(0.55, dark),
            ColorSequenceKeypoint.new(1, dark:Lerp(theme.Accent, 0.07)),
        })
    end
    if self.LineGradient then
        self.LineGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.Accent),
            ColorSequenceKeypoint.new(0.5, theme.AccentLight),
            ColorSequenceKeypoint.new(1, theme.Accent),
        })
    end
    if self.TitleGradient then
        self.TitleGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 255, 255)),
            ColorSequenceKeypoint.new(0.5, theme.AccentLight),
            ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 255, 255)),
        })
    end
    if self.AvatarGradient then
        self.AvatarGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.Accent),
            ColorSequenceKeypoint.new(0.5, theme.AccentLight),
            ColorSequenceKeypoint.new(1, theme.Accent),
        })
    end
    if self.ToggleGlow then
        TweenService:Create(self.ToggleGlow, TweenInfo.new(0.3), { BackgroundColor3 = theme.Accent }):Play()
    end
    for _, p in ipairs(self._particles or {}) do
        p.frame.BackgroundColor3 = theme.Accent
    end
    if self.SearchStroke then self.SearchStroke.Color = theme.Accent end
    -- индикаторы и подписи вкладок остаются белыми на акцентном фоне
end

-- ============================================================
-- ЭФФЕКТ КЛИКОВ В ИГРЕ (кружки на месте клика, как в монтажах)
-- ============================================================
local CLICK_STYLES = { Rings = true, Pulse = true, Burst = true, Focus = true }

local function getFxColor(fx)
    local c = fx.Color
    if typeof(c) == "Color3" then return c end
    if c == "rainbow" then return Color3.fromHSV((os.clock() * 0.35) % 1, 0.8, 1) end
    return THEMES[currentThemeKey].Accent
end

local function newFxCircle(parent, pos, startSize, color, z)
    local f = Instance.new("Frame")
    f.AnchorPoint = Vector2.new(0.5, 0.5)
    f.Position = UDim2.new(0, pos.X, 0, pos.Y)
    f.Size = UDim2.new(0, startSize, 0, startSize)
    f.BackgroundColor3 = color
    f.BackgroundTransparency = 1
    f.BorderSizePixel = 0
    f.ZIndex = z or 1
    f.Parent = parent
    createCorner(f, 999)
    return f
end

-- Window:SetClickEffect(true/false) — вкл/выкл
-- Window:SetClickEffect({ Style = "Burst", Color = "rainbow", Size = 100 }) — изменить настройки (вкл/выкл не трогает,
-- чтобы включить сразу, добавь Enabled = true). В CreateWindow({ ClickEffect = {...} }) эффект включается сам.
function Library:SetClickEffect(opt)
    local fx = self._clickFx
    if type(opt) == "boolean" then
        fx.Enabled = opt
    elseif type(opt) == "table" then
        for k, v in pairs(opt) do fx[k] = v end
    end
    if not CLICK_STYLES[fx.Style] then fx.Style = "Rings" end
    fx.Size = math.clamp(tonumber(fx.Size) or 80, 30, 300)
    fx.Rings = math.clamp(math.floor(tonumber(fx.Rings) or 3), 1, 6)
    fx.Duration = math.clamp(tonumber(fx.Duration) or 0.65, 0.2, 2)

    if fx.Enabled then
        if not self.ClickGui then
            -- отдельный ScreenGui поверх всего, чтобы круги были видны и над меню
            local gui = Instance.new("ScreenGui")
            gui.Name = "HIros_ClickFX"
            gui.ResetOnSpawn = false
            gui.IgnoreGuiInset = true
            gui.DisplayOrder = 100
            gui.Parent = PlayerGui
            self.ClickGui = gui
        end
        if not self._clickConn then
            self._clickConn = UserInputService.InputBegan:Connect(function(input, gp)
                local cfg = self._clickFx
                if not cfg.Enabled then return end
                if cfg.IgnoreGui and gp then return end
                local t = input.UserInputType
                if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.Touch
                    or (cfg.Right and t == Enum.UserInputType.MouseButton2) then
                    self:_spawnClickFX(pointerPos(input))
                end
            end)
        end
    else
        if self._clickConn then self._clickConn:Disconnect(); self._clickConn = nil end
    end
end

function Library:GetClickEffect()
    local copy = {}
    for k, v in pairs(self._clickFx) do copy[k] = v end
    return copy
end

function Library:_spawnClickFX(pos)
    local fx = self._clickFx
    local gui = self.ClickGui
    if not gui then return end
    if self._fxActive > 60 then return end -- защита от спама кликами

    local color = getFxColor(fx)
    local size, dur, n, style = fx.Size, fx.Duration, fx.Rings, fx.Style

    local function track(inst, lifetime)
        self._fxActive = self._fxActive + 1
        task.delay(lifetime, function()
            inst:Destroy()
            self._fxActive = math.max(0, self._fxActive - 1)
        end)
    end

    local info = TweenInfo.new(dur, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

    -- центральная точка-вспышка (у всех стилей)
    local dot = newFxCircle(gui, pos, 14, color, 3)
    dot.BackgroundTransparency = 0.2
    TweenService:Create(dot, TweenInfo.new(0.28, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
        Size = UDim2.new(0, 2, 0, 2), BackgroundTransparency = 1,
    }):Play()
    track(dot, 0.33)

    if style == "Rings" or style == "Focus" then
        -- 3 кольца с задержкой: Rings расходятся наружу, Focus сжимаются к точке клика
        for i = 1, n do
            local function make()
                local maxSize = size * (0.6 + 0.4 * (i / n))
                local focus = (style == "Focus")
                local c = newFxCircle(gui, pos, focus and maxSize or 10, color, 1)
                local stroke = Instance.new("UIStroke")
                stroke.Color = color
                stroke.Thickness = 3.5
                stroke.Transparency = focus and 0.4 or 0.1
                stroke.Parent = c
                local target = focus and 8 or maxSize
                TweenService:Create(c, info, { Size = UDim2.new(0, target, 0, target) }):Play()
                TweenService:Create(stroke, info, { Transparency = 1, Thickness = 0.8 }):Play()
                track(c, dur + 0.05)
            end
            if i == 1 then make() else task.delay((i - 1) * 0.09, make) end
        end

    elseif style == "Pulse" then
        -- заливные полупрозрачные круги, расходящиеся волной
        for i = 1, n do
            local function make()
                local maxSize = size * (0.6 + 0.4 * (i / n))
                local c = newFxCircle(gui, pos, 10, color, 1)
                c.BackgroundTransparency = 0.55
                TweenService:Create(c, info, {
                    Size = UDim2.new(0, maxSize, 0, maxSize), BackgroundTransparency = 1,
                }):Play()
                track(c, dur + 0.05)
            end
            if i == 1 then make() else task.delay((i - 1) * 0.09, make) end
        end

    elseif style == "Burst" then
        -- точки разлетаются лучами + одно кольцо
        local count = 6 + n * 2
        for i = 1, count do
            local ang = (i / count) * math.pi * 2
            local d = newFxCircle(gui, pos, 7, color, 2)
            d.BackgroundTransparency = 0.05
            TweenService:Create(d, info, {
                Position = UDim2.new(0, pos.X + math.cos(ang) * size * 0.6, 0, pos.Y + math.sin(ang) * size * 0.6),
                Size = UDim2.new(0, 2, 0, 2),
                BackgroundTransparency = 1,
            }):Play()
            track(d, dur + 0.05)
        end
        local c = newFxCircle(gui, pos, 10, color, 1)
        local stroke = Instance.new("UIStroke")
        stroke.Color = color
        stroke.Thickness = 3
        stroke.Transparency = 0.1
        stroke.Parent = c
        TweenService:Create(c, info, { Size = UDim2.new(0, size * 0.5, 0, size * 0.5) }):Play()
        TweenService:Create(stroke, info, { Transparency = 1, Thickness = 0.8 }):Play()
        track(c, dur + 0.05)
    end
end

-- ============================================================
-- ШАУТАУТ В DISCORD (только с явного согласия игрока)
-- ============================================================
local SHOUTOUT_MESSAGES = {
    "Всем привет! 👋 Я юзаю %s и это топ 💜",
    "%s — моя любимая библиотека для менюшек 🔥✨",
    "Го все на %s, реально удобно 😍",
    "Нашёл крутую либу — %s 💙 всем советую",
    "%s просто имба, бегите тестить 🚀💜",
    "Сижу на %s и кайфую 😎✨",
    "Если ещё не пробовали %s — зря, очень годно 🔥",
    "%s — лучшее, что я находил для менюшек в играх 💖",
    "Всем привет из %s! 👋💜 заходите, не пожалеете",
    "Юзаю %s каждый день, рекомендую 🙌✨",
}

local function dbg(...)
    if Library.ShoutoutDebug then print("[HIros Shoutout]", ...) end
end

-- HTTP-функция экзекьютора. Ищем как обычные глобалы (так они и лежат в окружении
-- скрипта), а не в _G — там их обычно нет.
local function execRequestFn()
    return (syn and syn.request) or (http and http.request) or http_request or request
        or (fluxus and fluxus.request)
end

-- GET: сначала game:HttpGet экзекьютора (ходит куда угодно, в т.ч. на roblox.com),
-- потом request(), потом HttpService.
local function httpGet(url)
    local ok, res = pcall(function() return game:HttpGet(url) end)
    if ok and type(res) == "string" and res ~= "" then
        dbg("GET ok через game:HttpGet:", url)
        return res
    end

    local reqFn = execRequestFn()
    if reqFn then
        local ok2, r = pcall(reqFn, { Url = url, Method = "GET" })
        if ok2 and type(r) == "table" and type(r.Body) == "string" and r.Body ~= "" then
            dbg("GET ok через request():", url)
            return r.Body
        end
    end

    local ok3, r3 = pcall(function() return game:GetService("HttpService"):GetAsync(url) end)
    if ok3 and r3 then
        dbg("GET ok через HttpService:", url)
        return r3
    end
    dbg("GET не удался:", url, ok3 and "" or tostring(r3))
    return nil
end

-- POST на вебхук. Сначала HttpService, при неудаче — функция экзекьютора.
function Library:_postWebhook(url, payload)
    if not url or url == "" then return end
    task.spawn(function()
        local HttpService = game:GetService("HttpService")
        local ok, encoded = pcall(function() return HttpService:JSONEncode(payload) end)
        if not ok then dbg("JSONEncode не удался", tostring(encoded)) return end

        local sent, err = pcall(function()
            HttpService:PostAsync(url, encoded, Enum.HttpContentType.ApplicationJson)
        end)
        if sent then dbg("POST ok через HttpService") return end
        dbg("HttpService:PostAsync не удался:", tostring(err))

        local reqFn = execRequestFn()
        if not reqFn then dbg("нет функции request() у экзекьютора, отправить не получилось") return end
        local ok2, res = pcall(reqFn, {
            Url = url,
            Method = "POST",
            Headers = { ["Content-Type"] = "application/json" },
            Body = encoded,
        })
        dbg("POST через request():", ok2 and "ok" or tostring(res),
            (ok2 and type(res) == "table") and ("код " .. tostring(res.StatusCode)) or "")
    end)
end

-- Ссылка на аватарку по ID игрока: нужна настоящая https-картинка (Discord не понимает rbxthumb://).
-- Спрашиваем API миниатюр Roblox (напрямую и через roproxy) и берём прямую ссылку на CDN.
local AVATAR_APIS = {
    "https://thumbnails.roblox.com/v1/users/avatar-headshot?userIds=%s&size=420x420&format=Png&isCircular=false",
    "https://thumbnails.roproxy.com/v1/users/avatar-headshot?userIds=%s&size=420x420&format=Png&isCircular=false",
}

local function getAvatarUrl(userId)
    local id = tostring(userId)
    for attempt = 1, 2 do
        local pending = false
        for _, tpl in ipairs(AVATAR_APIS) do
            local body = httpGet(string.format(tpl, id))
            if body then
                local ok, data = pcall(function() return game:GetService("HttpService"):JSONDecode(body) end)
                local item = ok and type(data) == "table" and type(data.data) == "table" and data.data[1] or nil
                if item then
                    if item.state == "Completed" and type(item.imageUrl) == "string"
                        and item.imageUrl:match("^https?://") then
                        dbg("аватар получен через API:", item.imageUrl)
                        return item.imageUrl
                    elseif item.state == "Pending" then
                        pending = true
                    end
                end
            end
        end
        if pending and attempt == 1 then task.wait(1.2) else break end
    end
    dbg("API миниатюр не дал ссылку, использую запасную")
    return "https://www.roblox.com/headshot-thumbnail/image?userId=" .. id .. "&width=420&height=420&format=png"
end

-- Согласился: случайное сообщение от имени игрока. Отказался: анонимный +1, без ника и аватарки.
function Library:_sendShoutout(webhookUrl, consented)
    task.spawn(function()
        local payload
        if consented then
            local template = SHOUTOUT_MESSAGES[math.random(1, #SHOUTOUT_MESSAGES)]
            payload = {
                content = string.format(template, BRAND),
                username = LocalPlayer.DisplayName .. " (@" .. LocalPlayer.Name .. ")",
                avatar_url = getAvatarUrl(LocalPlayer.UserId),
            }
        else
            payload = {
                content = "📊 +1 использование " .. BRAND .. " (игрок не стал делиться ником и аватаркой)",
            }
        end
        self:_postWebhook(webhookUrl, payload)
    end)
end

-- Window:PromptShoutout({ Webhook = "https://discord.com/api/webhooks/..." })
-- Показывает Confirm-попап и ничего не отправляет, пока игрок не ответит.
-- Спрашивает один раз за запуск.
function Library:PromptShoutout(config)
    config = config or {}
    local webhookUrl = config.Webhook
    if not webhookUrl or webhookUrl == "" then return end
    if self._shoutoutAsked then return end
    self._shoutoutAsked = true
    if config.Debug then Library.ShoutoutDebug = true end

    task.delay(config.Delay or 2.5, function()
        self:Confirm({
            Title = config.Title or "Поделиться в Discord? 💜",
            Content = config.Content or ("Хочешь, чтобы в нашем Discord написали от твоего имени, что ты используешь "
                .. BRAND .. "? Будут видны твой ник и аватарка. Если откажешься — просто +1 к счётчику без твоих данных."),
            YesText = config.YesText or "Да, го 💜",
            NoText = config.NoText or "Нет, просто посчитать",
            Callback = function(yes)
                self:_sendShoutout(webhookUrl, yes)
            end,
        })
    end)
end

function Library:SetParticles(enabled)
    self._particlesEnabled = enabled and true or false
    if self.ParticleLayer then self.ParticleLayer.Visible = self._particlesEnabled end
end

-- Вызывается каждый кадр: все "живые" анимации окна в одном месте
function Library:_animate(dt, t)
    if self.StrokeGradient then
        self.StrokeGradient.Offset = Vector2.new((t * 0.18) % 1, 0)
    end
    if self.LineGradient then
        self.LineGradient.Offset = Vector2.new(math.sin(t * 0.9) * 0.6, 0)
    end
    if self.TitleGradient then
        self.TitleGradient.Offset = Vector2.new(math.sin(t * 0.7) * 0.5, 0)
    end
    if self.AvatarGradient then
        self.AvatarGradient.Rotation = (t * 60) % 360
    end
    if self.ToggleGlow then
        local pulse = math.sin(t * 2.2)
        local base = self.Enabled and 0.62 or 0.8
        self.ToggleGlow.BackgroundTransparency = base + pulse * 0.08
        local sz = 64 + pulse * 5
        self.ToggleGlow.Size = UDim2.new(0, sz, 0, sz)
    end
    if self.Enabled and self._particlesEnabled and not self._minimized then
        for _, p in ipairs(self._particles) do
            p.y = p.y - p.speed * dt
            if p.y < -0.05 then
                p.y = 1.05
                p.x = math.random()
            end
            local sx = p.x + math.sin(t * 0.8 + p.sway) * p.swayAmp
            p.frame.Position = UDim2.new(sx, 0, p.y, 0)
        end
    end
end

function Library:SetGlowMode(mode)
    self._glowMode = (mode == "rainbow") and "rainbow" or "theme"
    if self._glowMode == "theme" then
        local theme = THEMES[currentThemeKey]
        for _, l in ipairs(self.GlowLayers) do
            TweenService:Create(l.instance, TweenInfo.new(0.4), { BackgroundColor3 = theme.Accent }):Play()
        end
    end
end

function Library:SetTheme(key)
    if not THEMES[key] then return end
    currentThemeKey = key
    local theme = THEMES[key]

    self:_applyThemeVisuals()
    for _, l in ipairs(self.GlowLayers or {}) do
        TweenService:Create(l.instance, TweenInfo.new(0.3), { BackgroundColor3 = theme.Accent }):Play()
    end
    if self.StrokeGradient then
        self.StrokeGradient.Color = ColorSequence.new({
            ColorSequenceKeypoint.new(0, theme.Accent),
            ColorSequenceKeypoint.new(0.5, theme.AccentLight),
            ColorSequenceKeypoint.new(1, theme.Accent),
        })
    end
    if self.TitleIcon then self.TitleIcon.TextColor3 = theme.Accent end
    if self.ToggleBtnStroke then TweenService:Create(self.ToggleBtnStroke, TweenInfo.new(0.3), { Color = theme.Accent }):Play() end

    for _, sb in ipairs(self._scrollBars or {}) do
        TweenService:Create(sb, TweenInfo.new(0.3), { ScrollBarImageColor3 = theme.Accent }):Play()
    end
    for _, el in ipairs(self.Elements) do
        if el.UpdateTheme then el.UpdateTheme() end
    end
    if self.CurrentTab and self.TabButtons[self.CurrentTab] then
        TweenService:Create(self.TabButtons[self.CurrentTab], TweenInfo.new(0.2), { BackgroundColor3 = theme.Accent }):Play()
    end
end

-- ============================================================
-- ACCESSIBILITY (меньше анимаций, масштаб, контраст)
-- ============================================================
local ACCESSIBILITY = { ReduceMotion = false, Scale = 1, HighContrast = false }
local CONTRAST_PANEL = Color3.fromRGB(8, 8, 10)
local CONTRAST_TEXT = Color3.fromRGB(255, 255, 255)
local CONTRAST_SUBTEXT = Color3.fromRGB(214, 214, 220)

function Library:GetAccessibility()
    return {
        ReduceMotion = ACCESSIBILITY.ReduceMotion,
        Scale = ACCESSIBILITY.Scale,
        HighContrast = ACCESSIBILITY.HighContrast,
    }
end

function Library:_saveAccessibility()
    self._accessibilityFlag = self._accessibilityFlag or "accessibility"
    self:SetFlag(self._accessibilityFlag, {
        ReduceMotion = ACCESSIBILITY.ReduceMotion,
        Scale = ACCESSIBILITY.Scale,
        HighContrast = ACCESSIBILITY.HighContrast,
    })
end

-- Применяет настройки ко всем уже созданным элементам (нужно после SetTheme,
-- потому что тема возвращает стандартные цвета).
function Library:_applyAccessibility()
    if not ACCESSIBILITY.HighContrast then return end
    if self.ScreenGui then self:_applyContrast(self.ScreenGui) end
end

function Library:_applyContrast(object)
    if typeof(object) ~= "Instance" then return end
    if object:IsA("TextLabel") or object:IsA("TextButton") or object:IsA("TextBox") then
        object.TextColor3 = CONTRAST_TEXT
        if object:IsA("TextBox") then
            pcall(function() object.PlaceholderColor3 = CONTRAST_SUBTEXT end)
        end
    end
    if object:IsA("Frame") or object:IsA("TextButton") or object:IsA("TextBox") or object:IsA("CanvasGroup") then
        -- Затемняем только панели/строки: акцентные кнопки остаются цветными.
        local transparency = tonumber(object.BackgroundTransparency)
        local color = object.BackgroundColor3
        if transparency and transparency < 0.5 and color and math.max(color.R, color.G, color.B) <= 0.5 then
            object.BackgroundColor3 = CONTRAST_PANEL
        end
    end
    for _, child in ipairs(object:GetChildren()) do
        self:_applyContrast(child)
    end
end

function Library:_setHighContrast(enabled)
    ACCESSIBILITY.HighContrast = enabled and true or false
    if ACCESSIBILITY.HighContrast then
        if self.ScreenGui and not self._contrastConn then
            local ok, conn = pcall(function()
                return self.ScreenGui.DescendantAdded:Connect(function(desc)
                    if ACCESSIBILITY.HighContrast then self:_applyContrast(desc) end
                end)
            end)
            self._contrastConn = ok and conn or nil
        end
        if self.ScreenGui then self:_applyContrast(self.ScreenGui) end
    else
        if self._contrastConn then self._contrastConn:Disconnect() self._contrastConn = nil end
        if self.ScreenGui then
            if self.Main then
                self.Main.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
            end
            self:_applyThemeVisuals()
            for _, el in ipairs(self.Elements or {}) do
                if el.UpdateTheme then el.UpdateTheme() end
            end
        end
    end
end

function Library:_syncUIScale()
    if not self.ScreenGui then return end
    if not self._uiScale then
        local scale = Instance.new("UIScale")
        scale.Name = "AccessibilityScale"
        scale.Parent = self.ScreenGui
        self._uiScale = scale
    end
    self._uiScale.Scale = ACCESSIBILITY.Scale
end

function Library:SetAccessibility(config)
    config = config or {}
    if config.ReduceMotion ~= nil then
        ACCESSIBILITY.ReduceMotion = config.ReduceMotion and true or false
        TWEEN_SCALE = ACCESSIBILITY.ReduceMotion and 0 or 1
    end
    if config.Scale ~= nil then
        local scale = tonumber(config.Scale)
        if scale then
            ACCESSIBILITY.Scale = math.clamp(scale, 0.6, 1.6)
            self:_syncUIScale()
        end
    end
    if config.HighContrast ~= nil then
        self:_setHighContrast(config.HighContrast)
    end
    if config.Sounds ~= nil then
        self:SetSoundsEnabled(config.Sounds and true or false)
    end
    if config.Save ~= false then self:_saveAccessibility() end
    return self:GetAccessibility()
end

function Library:SetReduceMotion(enabled) return self:SetAccessibility({ ReduceMotion = enabled }) end
function Library:SetUIScale(scale) return self:SetAccessibility({ Scale = scale }) end
function Library:SetHighContrast(enabled) return self:SetAccessibility({ HighContrast = enabled }) end

-- ============================================================
-- NOTIFY (очередь, прогресс-бар, кнопки действий)
-- ============================================================
-- local note = Library:Notify({
--     Kind = "success", Title = "Готово", Content = "Конфиг сохранён",
--     Duration = 6, Progress = 0, Sticky = false,
--     Actions = { { Name = "Открыть", Callback = function(note) end, Primary = true } },
-- })
-- note:SetProgress(0.5)  note:SetTitle("...")  note.Close(note)  note:Close()
-- Возвращается handle: он и объект (SetProgress/SetTitle/Close/Instance/Queued),
-- и обычное уведомление — чтение свойств и методы Frame проксируются (note.Position,
-- note:Destroy()). Уведомления сверх лимита (MaxVisible, по умолчанию 4) ждут в
-- очереди; когда слот освобождается, показывается самое приоритетное (Priority).
local NOTIFY_KINDS = {
    info    = { Symbol = "💬" },
    success = { Symbol = "✅", Accent = Color3.fromRGB(60, 200, 120) },
    error   = { Symbol = "❌", Accent = Color3.fromRGB(235, 80, 90) },
    warning = { Symbol = "⚠️", Accent = Color3.fromRGB(255, 180, 60) },
    loading = { Symbol = "⏳" },
}
local NOTIFY_WIDTH = 280
local NOTIFY_GAP = 8
local NOTIFY_MARGIN = 20

function Library:_notifyMaxVisible(config)
    local explicit = config and tonumber(config.MaxVisible)
    if explicit and explicit >= 1 then return math.floor(explicit) end
    local configured = tonumber(self.Config and self.Config.MaxNotifications)
    if configured and configured >= 1 then return math.floor(configured) end
    return 4
end

function Library:_visibleNotifyCount()
    return #(self._activeNotifies or {})
end

function Library:_notifyHeight(config, actionCount)
    local hasContent = config.Content ~= nil and tostring(config.Content) ~= ""
    return (hasContent and 66 or 44) + (actionCount > 0 and 30 or 0)
end

function Library:_reflowNotifies()
    local y = NOTIFY_MARGIN
    for _, record in ipairs(self._activeNotifies or {}) do
        TweenService:Create(record.Frame, TweenInfo.new(0.35, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
            Position = UDim2.new(1, -(NOTIFY_WIDTH + NOTIFY_MARGIN), 0, y),
        }):Play()
        y = y + record.Height + NOTIFY_GAP
    end
end

-- Показывает следующее уведомление из очереди (самое приоритетное, при равенстве — самое раннее)
function Library:_promoteNotify()
    local queue = self._notifyQueue
    if not queue or #queue == 0 then return end
    local bestIndex, best
    for i, record in ipairs(queue) do
        if not best or record.Priority > best.Priority
            or (record.Priority == best.Priority and record.Seq < best.Seq) then
            bestIndex, best = i, record
        end
    end
    if not best then return end
    if self:_visibleNotifyCount() >= self:_notifyMaxVisible(best.Config) then return end
    table.remove(queue, bestIndex)
    if best.Handle.Closed then return self:_promoteNotify() end
    best.Handle.Queued = false
    self:_buildNotification(best.Config, best.Handle)
end

function Library:_createNotifyHandle(config)
    local self = self
    local handle = {
        Config = config,
        Closed = false,
        Queued = false,
        Visible = false,
        Instance = nil,
        Frame = nil,
        Priority = tonumber(config.Priority) or 0,
        Progress = tonumber(config.Progress),
    }
    local visuals = {}
    handle._visuals = visuals

    -- Методы handle вызываются и через точку, и через двоеточие:
    -- note:SetProgress(0.5) и note.SetProgress(0.5) равнозначны.
    local function pick(value, extra)
        if value == handle or value == handle.Proxy then return extra end
        return value
    end

    function handle.Close()
        if handle.Closed then return false end
        if handle.Queued then
            handle.Queued = false
            handle.Closed = true
            handle.Visible = false
            for i, record in ipairs(self._notifyQueue or {}) do
                if record.Handle == handle then
                    table.remove(self._notifyQueue, i)
                    break
                end
            end
            if type(config.OnClose) == "function" then pcall(config.OnClose, handle.Proxy, "queued") end
            return true
        end
        if visuals.Close then return visuals.Close() end
        return false
    end

    function handle.SetProgress(first, second, third)
        local value, instant
        if first == handle or first == handle.Proxy then value, instant = second, third
        else value, instant = first, second end
        if value == nil then return false end
        handle.Progress = math.clamp(tonumber(value) or 0, 0, 1)
        if visuals.SetProgress then return visuals.SetProgress(handle.Progress, instant) end
        return false
    end

    function handle.SetTitle(first, second)
        local text = pick(first, second)
        if visuals.SetTitle then return visuals.SetTitle(text) end
        return false
    end

    function handle.SetContent(first, second)
        local text = pick(first, second)
        if visuals.SetContent then return visuals.SetContent(text) end
        return false
    end

    function handle.SetKind(first, second)
        local kind = pick(first, second)
        if visuals.SetKind then return visuals.SetKind(kind) end
        return false
    end

    function handle.IsVisible() return handle.Visible end

    -- Прокси: handle ведёт себя и как объект уведомления, и как сам Frame.
    local proxy
    proxy = setmetatable({}, {
        __index = function(_, key)
            local own = rawget(handle, key)
            if own ~= nil then return own end
            local frame = rawget(handle, "Frame")
            if not frame then return nil end
            local value = frame[key]
            if type(value) == "function" then
                return function(_, ...) return value(frame, ...) end
            end
            return value
        end,
        __newindex = function(_, key, value)
            local frame = rawget(handle, "Frame")
            if frame then frame[key] = value else rawset(handle, key, value) end
        end,
    })
    handle.Proxy = proxy
    return handle
end

function Library:_buildNotification(config, handle)
    local self = self
    local kindConfig = NOTIFY_KINDS[config.Kind] or NOTIFY_KINDS.info
    local accent = config.Accent or kindConfig.Accent or THEMES[currentThemeKey].Accent
    local symbol = config.Icon or kindConfig.Symbol

    local actions = {}
    for _, source in ipairs(type(config.Actions) == "table" and config.Actions or {}) do
        if type(source) == "table" and (source.Name or source.Text or source.Icon) then
            actions[#actions + 1] = source
        elseif type(source) == "string" then
            actions[#actions + 1] = { Name = source }
        end
    end

    local hasContent = config.Content ~= nil and tostring(config.Content) ~= ""
    local hasProgress = config.Progress ~= nil and config.Progress ~= false
    local duration = config.Duration
    if duration == nil then duration = config.Sticky and 0 or 5 end
    duration = tonumber(duration) or 0
    local sticky = config.Sticky == true or duration <= 0 or duration == math.huge
    local height = self:_notifyHeight(config, #actions)

    local notify = Instance.new("CanvasGroup")
    notify.Name = "Notification"
    notify.Size = UDim2.new(0, NOTIFY_WIDTH, 0, height)
    notify.Position = UDim2.new(1, NOTIFY_MARGIN, 0, NOTIFY_MARGIN)
    notify.BackgroundColor3 = BG_PANEL
    notify.BorderSizePixel = 0
    notify.ZIndex = 999
    notify.Parent = self.ScreenGui
    createCorner(notify, 12)

    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = accent
    stroke.Thickness = 2
    stroke.Parent = notify

    local iconCircle = Instance.new("Frame")
    iconCircle.Size = UDim2.new(0, 26, 0, 26)
    iconCircle.Position = UDim2.new(0, 10, 0, 10)
    iconCircle.BackgroundColor3 = accent
    iconCircle.BackgroundTransparency = 0.7
    iconCircle.BorderSizePixel = 0
    iconCircle.ZIndex = 1000
    iconCircle.Parent = notify
    createCorner(iconCircle, 999)

    local iconLabel = Instance.new("TextLabel")
    iconLabel.BackgroundTransparency = 1
    iconLabel.Size = UDim2.new(1, 0, 1, 0)
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.Text = symbol
    iconLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    iconLabel.TextSize = 13
    iconLabel.ZIndex = 1001
    iconLabel.Parent = iconCircle

    local percentLabel
    if hasProgress and config.ShowPercent ~= false then
        percentLabel = Instance.new("TextLabel")
        percentLabel.Name = "NotifyPercent"
        percentLabel.BackgroundTransparency = 1
        percentLabel.Position = UDim2.new(1, -58, 0, 12)
        percentLabel.Size = UDim2.new(0, 46, 0, 18)
        percentLabel.Font = Enum.Font.GothamBold
        percentLabel.Text = "0%"
        percentLabel.TextColor3 = accent
        percentLabel.TextSize = 11
        percentLabel.TextXAlignment = Enum.TextXAlignment.Right
        percentLabel.ZIndex = 1000
        percentLabel.Parent = notify
    end

    local title = Instance.new("TextLabel")
    title.Name = "NotifyTitle"
    title.BackgroundTransparency = 1
    title.Position = UDim2.new(0, 46, 0, 10)
    title.Size = UDim2.new(1, percentLabel and -112 or -58, 0, 20)
    title.Font = Enum.Font.GothamBold
    title.Text = config.Title or "Уведомление"
    title.TextColor3 = TEXT_COLOR
    title.TextSize = 14
    title.TextXAlignment = Enum.TextXAlignment.Left
    title.TextTruncate = Enum.TextTruncate.AtEnd
    title.ZIndex = 1000
    title.Parent = notify

    local content = Instance.new("TextLabel")
    content.Name = "NotifyContent"
    content.BackgroundTransparency = 1
    content.Position = UDim2.new(0, 46, 0, 30)
    content.Size = UDim2.new(1, -58, 0, 28)
    content.Font = Enum.Font.Gotham
    content.Text = hasContent and tostring(config.Content) or ""
    content.TextColor3 = SUBTEXT
    content.TextSize = 12
    content.TextXAlignment = Enum.TextXAlignment.Left
    content.TextWrapped = true
    content.Visible = hasContent
    content.ZIndex = 1000
    content.Parent = notify

    local actionButtons = {}
    for actionIndex, action in ipairs(actions) do
        local button = Instance.new("TextButton")
        button.Name = "NotifyAction_" .. actionIndex
        button.BackgroundColor3 = action.Primary and accent or BG_HOVER
        button.BackgroundTransparency = action.Primary and 0 or 0.2
        button.BorderSizePixel = 0
        button.AutoButtonColor = false
        button.Font = Enum.Font.GothamBold
        button.Text = tostring(action.Text or action.Name or "OK")
        button.TextColor3 = action.Primary and Color3.fromRGB(255, 255, 255) or TEXT_COLOR
        button.TextSize = 11
        button.ZIndex = 1001
        button.Parent = notify
        createCorner(button, 7)
        button.MouseButton1Click:Connect(function()
            if type(action.Callback) == "function" then pcall(action.Callback, handle.Proxy, action) end
            if action.Close ~= false then handle.Close() end
        end)
        actionButtons[#actionButtons + 1] = button
    end
    if #actionButtons > 0 then
        local gap = 6
        local buttonWidth = (NOTIFY_WIDTH - 24 - gap * (#actionButtons - 1)) / #actionButtons
        for i, button in ipairs(actionButtons) do
            button.Position = UDim2.new(0, 12 + (i - 1) * (buttonWidth + gap), 0, height - 32)
            button.Size = UDim2.new(0, buttonWidth, 0, 22)
        end
    end

    -- Нижняя полоса: таймер показа (сокращается) либо прогресс задачи (растёт)
    local track = Instance.new("Frame")
    track.Name = hasProgress and "NotifyProgress" or "NotifyTimer"
    track.Position = UDim2.new(0, 12, 1, -8)
    track.Size = UDim2.new(1, -24, 0, 3)
    track.BackgroundColor3 = accent
    track.BackgroundTransparency = 0.75
    track.BorderSizePixel = 0
    -- у липкого уведомления нет обратного отсчёта, но прогресс-бар нужен
    track.Visible = hasProgress or not sticky
    track.ZIndex = 1000
    track.Parent = notify
    createCorner(track, 999)

    local fill = Instance.new("Frame")
    fill.Name = "Fill"
    fill.Size = hasProgress and UDim2.new(0, 0, 1, 0) or UDim2.new(1, 0, 1, 0)
    fill.BackgroundColor3 = accent
    fill.BackgroundTransparency = 0.25
    fill.BorderSizePixel = 0
    fill.ZIndex = 1001
    fill.Parent = track
    createCorner(fill, 999)

    handle.Frame = notify
    handle.Instance = notify
    handle.Height = height
    handle.Visible = true
    handle.Kind = config.Kind or "info"

    self._activeNotifies = self._activeNotifies or {}
    table.insert(self._activeNotifies, { Frame = notify, Height = height, Handle = handle })

    local closed = false
    local function finishClose()
        if closed then return end
        closed = true
        handle.Closed = true
        handle.Visible = false
        for i, record in ipairs(self._activeNotifies or {}) do
            if record.Handle == handle then
                table.remove(self._activeNotifies, i)
                break
            end
        end
        self:_reflowNotifies()
        if notify.Parent then notify:Destroy() end
        if type(config.OnClose) == "function" then pcall(config.OnClose, handle.Proxy) end
        self:_promoteNotify()
    end

    handle._visuals.Close = function()
        if closed then return false end
        local tween = TweenService:Create(notify, TweenInfo.new(0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.In), {
            Position = UDim2.new(1, NOTIFY_MARGIN, 0, notify.Position.Y.Offset),
            GroupTransparency = 1,
        })
        tween:Play()
        tween.Completed:Connect(finishClose)
        return true
    end

    handle._visuals.SetTitle = function(text)
        title.Text = tostring(text or "")
        return true
    end

    handle._visuals.SetContent = function(text)
        local value = tostring(text or "")
        content.Text = value
        content.Visible = value ~= ""
        return true
    end

    handle._visuals.SetProgress = function(value, instant)
        if not hasProgress then return false end
        if percentLabel then
            percentLabel.Text = string.format("%d%%", math.floor(value * 100 + 0.5))
        end
        if instant or config.ProgressTween == false then
            fill.Size = UDim2.new(value, 0, 1, 0)
        else
            TweenService:Create(fill, TweenInfo.new(0.18), { Size = UDim2.new(value, 0, 1, 0) }):Play()
        end
        if value >= 1 and config.CloseOnComplete == true then
            task.delay(tonumber(config.CloseDelay) or 0.35, function()
                if not closed then handle.Close() end
            end)
        end
        return true
    end

    handle._visuals.SetKind = function(kind)
        local kindData = NOTIFY_KINDS[kind] or NOTIFY_KINDS.info
        local newAccent = config.Accent or kindData.Accent or THEMES[currentThemeKey].Accent
        stroke.Color = newAccent
        iconCircle.BackgroundColor3 = newAccent
        track.BackgroundColor3 = newAccent
        fill.BackgroundColor3 = newAccent
        iconLabel.Text = config.Icon or kindData.Symbol
        if percentLabel then percentLabel.TextColor3 = newAccent end
        handle.Kind = kind
        return true
    end

    if type(config.OnClick) == "function" then
        local body = Instance.new("TextButton")
        body.Name = "NotifyBody"
        body.BackgroundTransparency = 1
        body.BorderSizePixel = 0
        body.Text = ""
        body.AutoButtonColor = false
        body.Size = UDim2.new(1, 0, 1, 0)
        body.ZIndex = 998
        body.Parent = notify
        body.MouseButton1Click:Connect(function()
            pcall(config.OnClick, handle.Proxy)
            if config.CloseOnClick ~= false then handle.Close() end
        end)
    end

    if hasProgress then
        handle.SetProgress(handle.Progress or 0, true)
    elseif not sticky then
        TweenService:Create(fill, TweenInfo.new(duration, Enum.EasingStyle.Linear), {
            Size = UDim2.new(0, 0, 1, 0),
        }):Play()
        task.delay(duration, function()
            if closed or handle.Queued then return end
            handle.Close()
        end)
    end

    if config.Sound ~= false then self:_play("Notify") end

    -- Въезд справа: стартовая позиция за экраном, reflow плавно ставит на место
    self:_reflowNotifies()
    return handle
end

function Library:Notify(config)
    config = config or {}
    self._notifyQueue = self._notifyQueue or {}
    self._activeNotifies = self._activeNotifies or {}
    local handle = self:_createNotifyHandle(config)
    if self:_visibleNotifyCount() >= self:_notifyMaxVisible(config) then
        self._notifySeq = (self._notifySeq or 0) + 1
        handle.Queued = true
        handle.Seq = self._notifySeq
        self._notifyQueue[#self._notifyQueue + 1] = {
            Config = config,
            Handle = handle,
            Priority = handle.Priority,
            Seq = handle.Seq,
        }
        return handle.Proxy
    end
    self:_buildNotification(config, handle)
    return handle.Proxy
end

function Library:GetNotifications()
    local out = {}
    for _, record in ipairs(self._activeNotifies or {}) do out[#out + 1] = record.Handle.Proxy end
    for _, record in ipairs(self._notifyQueue or {}) do out[#out + 1] = record.Handle.Proxy end
    return out
end

function Library:GetQueuedNotifications()
    local out = {}
    for _, record in ipairs(self._notifyQueue or {}) do out[#out + 1] = record.Handle.Proxy end
    return out
end

function Library:ClearNotifications()
    local queued = self._notifyQueue or {}
    for _, record in ipairs(queued) do
        record.Handle.Queued = false
        record.Handle.Closed = true
        record.Handle.Visible = false
    end
    self._notifyQueue = {}
    -- копия списка: Close() удаляет записи из _activeNotifies
    local active = {}
    for i, record in ipairs(self._activeNotifies or {}) do active[i] = record end
    for _, record in ipairs(active) do
        record.Handle.Close()
    end
end

-- ============================================================
-- HUD-ВИДЖЕТЫ (перетаскивание, привязка к углам, сохранение позиции)
-- ============================================================
-- local hud = Library:CreateHUD({
--     Name = "FPS", Text = "60 FPS", Icon = "🎯", Position = "top-left",
--     Flag = "hud_fps", Draggable = true, OnClick = function(widget) end,
-- })
-- hud:SetText("120 FPS")   hud:SetIcon("⚡")   hud:SetVisible(false)
-- hud:SetPosition("bottom-right")   hud:GetPosition().Side
-- Позиция (Side / X / Y) пишется в Flag, поэтому переживает перезапуск.
local HUD_MARGIN = 16

local function isHUDSide(side)
    return side == "top-left" or side == "top-right" or side == "bottom-left" or side == "bottom-right"
end

function Library:_ensureHUDLayer()
    if self._hudLayer and self._hudLayer.Parent then return self._hudLayer end
    local layer = Instance.new("Frame")
    layer.Name = "HUDLayer"
    layer.BackgroundTransparency = 1
    layer.Size = UDim2.new(1, 0, 1, 0)
    layer.ZIndex = 900
    layer.Parent = self.ScreenGui
    self._hudLayer = layer
    return layer
end

function Library:_hudContainerSize()
    local layer = self:_ensureHUDLayer()
    local size = layer and layer.AbsoluteSize
    if size and tonumber(size.X) and tonumber(size.Y) and size.X > 0 and size.Y > 0 then
        return size.X, size.Y
    end
    return 1280, 720
end

function Library:CreateHUD(config)
    config = config or {}
    local self = self
    local layer = self:_ensureHUDLayer()

    local width = math.clamp(math.floor(tonumber(config.Width) or 132), 56, 360)
    local height = math.clamp(math.floor(tonumber(config.Height) or 34), 24, 90)
    local draggable = config.Draggable ~= false
    local background = config.Background or BG_PANEL

    local widget = Instance.new("TextButton")
    widget.Name = tostring(config.Name or "HUDWidget")
    widget.BackgroundColor3 = background
    widget.BackgroundTransparency = 0.08
    widget.BorderSizePixel = 0
    widget.AutoButtonColor = false
    widget.Text = ""
    widget.Size = UDim2.new(0, width, 0, height)
    widget.ZIndex = 902
    widget.Parent = layer
    createCorner(widget, math.min(10, math.floor(height / 2)))

    local stroke = Instance.new("UIStroke")
    stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    stroke.Color = config.Accent or THEMES[currentThemeKey].Accent
    stroke.Thickness = 1.4
    stroke.Transparency = 0.35
    stroke.Parent = widget

    local iconLabel = Instance.new("TextLabel")
    iconLabel.Name = "HUDIcon"
    iconLabel.BackgroundTransparency = 1
    iconLabel.Position = UDim2.new(0, 6, 0, 0)
    iconLabel.Size = UDim2.new(0, 22, 1, 0)
    iconLabel.Font = Enum.Font.GothamBold
    iconLabel.Text = tostring(config.Icon or "•")
    iconLabel.TextColor3 = config.Accent or THEMES[currentThemeKey].Accent
    iconLabel.TextSize = 14
    iconLabel.ZIndex = 903
    iconLabel.Parent = widget

    local textLabel = Instance.new("TextLabel")
    textLabel.Name = "HUDText"
    textLabel.BackgroundTransparency = 1
    textLabel.Position = UDim2.new(0, 28, 0, 0)
    textLabel.Size = UDim2.new(1, -34, 1, 0)
    textLabel.Font = Enum.Font.GothamBold
    textLabel.Text = tostring(config.Text or config.Name or "HUD")
    textLabel.TextColor3 = TEXT_COLOR
    textLabel.TextSize = 12
    textLabel.TextXAlignment = Enum.TextXAlignment.Left
    textLabel.TextTruncate = Enum.TextTruncate.AtEnd
    textLabel.ZIndex = 903
    textLabel.Parent = widget

    local side = isHUDSide(config.Position) and config.Position or "top-left"
    local positionMode = "corner"
    local offsetX, offsetY = HUD_MARGIN, HUD_MARGIN
    local dragging = false
    local dragMoved = false

    local function containerOffsets(cornerSide)
        local containerWidth, containerHeight = self:_hudContainerSize()
        if cornerSide == "top-right" then return containerWidth - width - HUD_MARGIN, HUD_MARGIN end
        if cornerSide == "bottom-left" then return HUD_MARGIN, containerHeight - height - HUD_MARGIN end
        if cornerSide == "bottom-right" then
            return containerWidth - width - HUD_MARGIN, containerHeight - height - HUD_MARGIN
        end
        return HUD_MARGIN, HUD_MARGIN
    end

    local function savePosition()
        if not config.Flag then return end
        self:SetFlag(config.Flag, {
            Side = side,
            Mode = positionMode,
            X = math.floor(offsetX),
            Y = math.floor(offsetY),
        })
    end

    local function applyPosition(animate)
        local target
        if positionMode == "free" then
            target = UDim2.new(0, math.floor(offsetX), 0, math.floor(offsetY))
        elseif side == "top-right" then
            target = UDim2.new(1, -HUD_MARGIN - width, 0, HUD_MARGIN)
        elseif side == "bottom-left" then
            target = UDim2.new(0, HUD_MARGIN, 1, -HUD_MARGIN - height)
        elseif side == "bottom-right" then
            target = UDim2.new(1, -HUD_MARGIN - width, 1, -HUD_MARGIN - height)
        else
            target = UDim2.new(0, HUD_MARGIN, 0, HUD_MARGIN)
        end
        if animate then
            TweenService:Create(widget, TweenInfo.new(0.22, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), {
                Position = target,
            }):Play()
        else
            widget.Position = target
        end
    end

    local function setSide(newSide, animate)
        if not isHUDSide(newSide) then return false end
        side = newSide
        positionMode = "corner"
        offsetX, offsetY = containerOffsets(side)
        applyPosition(animate)
        savePosition()
        return true
    end

    local function snapToCorner(animate)
        if config.SnapToCorners == false then
            positionMode = "free"
            savePosition()
            return side
        end
        local containerWidth, containerHeight = self:_hudContainerSize()
        local centerX = offsetX + width / 2
        local centerY = offsetY + height / 2
        local targetSide
        if centerY <= containerHeight / 2 then
            targetSide = centerX <= containerWidth / 2 and "top-left" or "top-right"
        else
            targetSide = centerX <= containerWidth / 2 and "bottom-left" or "bottom-right"
        end
        setSide(targetSide, animate)
        return targetSide
    end

    local function loadPosition()
        local saved = config.Flag and self.Flags[config.Flag]
        if type(saved) == "string" and isHUDSide(saved) then
            setSide(saved, false)
            return true
        end
        if type(saved) == "table" then
            if isHUDSide(saved.Side) then side = saved.Side end
            positionMode = saved.Mode == "free" and "free" or "corner"
            offsetX = tonumber(saved.X) or offsetX
            offsetY = tonumber(saved.Y) or offsetY
            if positionMode == "free" then
                applyPosition(false)
            else
                offsetX, offsetY = containerOffsets(side)
                applyPosition(false)
            end
            return true
        end
        if isHUDSide(config.Position) then
            side = config.Position
        end
        offsetX, offsetY = containerOffsets(side)
        applyPosition(false)
        -- начальная позиция тоже сохраняется, чтобы Flag сразу отражал состояние
        savePosition()
        return false
    end

    if draggable then
        widget.InputBegan:Connect(function(input)
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            dragging = true
            dragMoved = false
            -- AbsolutePosition даёт текущий пиксельный сдвиг (лейер во весь экран);
            -- в тестовой заглушке его нет — тогда берём сохранённые оффсеты.
            local absolute = widget.AbsolutePosition
            if absolute and tonumber(absolute.X) and tonumber(absolute.Y) then
                offsetX, offsetY = absolute.X, absolute.Y
            else
                offsetX, offsetY = containerOffsets(side)
            end
        end)
        UserInputService.InputChanged:Connect(function(input)
            if not dragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseMovement
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            local delta = input.Delta
            if type(delta) ~= "table" then return end
            if delta.X ~= 0 or delta.Y ~= 0 then dragMoved = true end
            offsetX = offsetX + delta.X
            offsetY = offsetY + delta.Y
            positionMode = "free"
            applyPosition(false)
        end)
        UserInputService.InputEnded:Connect(function(input)
            if not dragging then return end
            if input.UserInputType ~= Enum.UserInputType.MouseButton1
                and input.UserInputType ~= Enum.UserInputType.Touch then return end
            dragging = false
            if dragMoved then snapToCorner(true) end
        end)
    end

    local function setText(value)
        textLabel.Text = tostring(value or "")
        return true
    end

    local function setIcon(value)
        iconLabel.Text = tostring(value or "")
        iconLabel.Visible = iconLabel.Text ~= ""
        return true
    end

    local function updateTheme()
        widget.BackgroundColor3 = background
        stroke.Color = config.Accent or THEMES[currentThemeKey].Accent
        iconLabel.TextColor3 = config.Accent or THEMES[currentThemeKey].Accent
        textLabel.TextColor3 = TEXT_COLOR
    end

    local obj
    if type(config.OnClick) == "function" then
        widget.MouseButton1Click:Connect(function()
            if dragMoved then return end
            pcall(config.OnClick, obj)
        end)
    end
    addHover(widget, self)
    loadPosition()

    obj = {
        Instance = widget,
        GetText = function() return textLabel.Text end,
        SetText = function(first, second)
            if first == obj then setText(second) else setText(first) end
            return obj
        end,
        GetIcon = function() return iconLabel.Text end,
        SetIcon = function(first, second)
            if first == obj then setIcon(second) else setIcon(first) end
            return obj
        end,
        GetVisible = function() return widget.Visible end,
        SetVisible = function(first, second)
            local value
            if first == obj then value = second else value = first end
            widget.Visible = value ~= false
            return obj
        end,
        GetPosition = function()
            return { Side = side, Mode = positionMode, X = offsetX, Y = offsetY }
        end,
        SetPosition = function(first, second, third)
            local value
            if first == obj then value = second else value = first end
            if type(value) == "table" then
                if isHUDSide(value.Side) then return setSide(value.Side, true) end
                if tonumber(value.X) and tonumber(value.Y) then
                    offsetX, offsetY = tonumber(value.X), tonumber(value.Y)
                    positionMode = "free"
                    applyPosition(true)
                    savePosition()
                    return true
                end
                return false
            end
            if type(value) == "string" then return setSide(value, true) end
            if type(value) == "number" and tonumber(second) then
                offsetX, offsetY = value, tonumber(second)
                positionMode = "free"
                applyPosition(true)
                savePosition()
                return true
            end
            return false
        end,
        Snap = function() return snapToCorner(true) end,
        IsDragging = function() return dragging end,
        UpdateTheme = updateTheme,
        Destroy = function()
            if widget.Parent then widget:Destroy() end
            for i, entry in ipairs(self._hudWidgets or {}) do
                if entry == obj then table.remove(self._hudWidgets, i) break end
            end
            return true
        end,
    }

    self._hudWidgets = self._hudWidgets or {}
    table.insert(self._hudWidgets, obj)
    table.insert(self.Elements, { Type = "HUD", Instance = widget, UpdateTheme = updateTheme })
    return obj
end

function Library:CreateHUDWidget(config) return self:CreateHUD(config) end

function Library:GetHUDWidgets()
    local out = {}
    for i, widget in ipairs(self._hudWidgets or {}) do out[i] = widget end
    return out
end

function Library:SetHUDVisible(first, second)
    local value
    if first == self then value = second else value = first end
    local layer = self._hudLayer
    if not layer then return false end
    layer.Visible = value ~= false
    return true
end

function Library:DestroyHUDWidgets()
    local widgets = self._hudWidgets or {}
    for i = #widgets, 1, -1 do
        local widget = widgets[i]
        if widget.Destroy then widget.Destroy() end
    end
    self._hudWidgets = {}
    if self._hudLayer and self._hudLayer.Parent then self._hudLayer:Destroy() end
    self._hudLayer = nil
    return true
end
-- ============================================================
-- PATCH: avatar + shine
-- ============================================================
local _origCreateWindow = Library.CreateWindow
function Library:CreateWindow(config)
    local w = _origCreateWindow(self, config)
    if w.Avatar then
        task.spawn(function()
            local ok, content = pcall(function()
                return Players:GetUserThumbnailAsync(
                    LocalPlayer.UserId,
                    Enum.ThumbnailType.HeadShot,
                    Enum.ThumbnailSize.Size100x100
                )
            end)
            if ok and content then w.Avatar.Image = content end
        end)
    end
    task.spawn(function()
        local t = 0
        while w.ScreenGui and w.ScreenGui.Parent do
            local dt = RunService.Heartbeat:Wait()
            t = t + dt
            w:_animate(dt, t)
        end
    end)
    return w
end

return Library
